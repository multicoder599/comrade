# ── Comrade Shop POS configuration ─────────────────────────────
# Copy this file to .env and fill in your values.

# REQUIRED on the VPS — dist/boot.js only binds ports in production mode
NODE_ENV=production

# Ports (the two shops and admin run on ONE server process)
SHOP_PORT=5105          # cashier till  → http://169.58.58.133:5105
ADMIN_PORT=5106         # admin panel   → http://169.58.58.133:5106/admin
PORT=3000               # extra convenience port (optional, leave as-is)

# SQLite database file (created automatically on first boot)
DATABASE_PATH=./data/comrade-shop.db

# Secret for signing login tokens — CHANGE THIS to a long random string
JWT_SECRET=change-me-to-a-long-random-string

# MegaPay M-Pesa STK Push — EACH SHOP USES ITS OWN MegaPay account so the
# money lands in the right account. From https://megapay.co.ke → Linked
# Accounts → copy the API key for each shop's account.
# Shop A:
MEGAPAY_API_KEY=
MEGAPAY_EMAIL=
# Shop B:
MEGAPAY_B_API_KEY=
MEGAPAY_B_EMAIL=

# Where MegaPay posts payment results after the customer enters their PIN.
# Must be reachable from the internet and match the webhook URL set in BOTH
# MegaPay accounts' dashboards.
MEGAPAY_CALLBACK_URL=http://169.58.58.133:5105/api/megapay/webhook

# Only change if MegaPay support gives you a different base URL
MEGAPAY_BASE_URL=https://megapay.co.ke/backend/v1
